    "rate": 0.62
  },
  {
    "key": "text.t1.s0",
    "text": "هٰذِهِ قِطَّةٌ صَغِيرَةٌ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t1.s1",
    "text": "اِسْمُهَا لُولُو.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t1.s2",
    "text": "تَلْعَبُ لُولُو فِي الْحَدِيقَةِ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t2.s0",
    "text": "فَتَحَ مَالِكٌ كِتَابَهُ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t2.s1",
    "text": "قَرَأَ قِصَّةً عَنِ الْقَمَرِ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t2.s2",
    "text": "ثُمَّ رَسَمَ قَمَرًا كَبِيرًا.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t2.s3",
    "text": "فَرِحَتْ أُمُّهُ بِالرَّسْمِ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t3.s0",
    "text": "خَرَجَتْ سَلْمَى إِلَى الْحَدِيقَةِ فِي الصَّبَاحِ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t3.s1",
    "text": "رَأَتْ عُصْفُورًا صَغِيرًا عَلَى الشَّجَرَةِ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t3.s2",
    "text": "كَانَ الْعُصْفُورُ جَائِعًا، فَوَضَعَتْ لَهُ بَعْضَ الْحَبِّ.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "text.t3.s3",
    "text": "أَكَلَ الْعُصْفُورُ وَغَرَّدَ فَرِحًا.",
    "kind": "جملة في نصّ",
    "rate": 0.72
  },
  {
    "key": "q.t1q1",
    "text": "مَا اسْمُ الْقِطَّةِ؟",
    "kind": "سؤال فهم",
    "rate": 0.8
  },
  {
    "key": "q.t1q2",
    "text": "أَيْنَ تَلْعَبُ لُولُو؟",
    "kind": "سؤال فهم",
    "rate": 0.8
  },
  {
    "key": "q.t2q1",
    "text": "مَاذَا فَعَلَ مَالِكٌ أَوَّلًا؟",
    "kind": "سؤال فهم",
    "rate": 0.8
  },
  {
    "key": "q.t2q2",
    "text": "عَنْ مَاذَا قَرَأَ مَالِكٌ؟",
    "kind": "سؤال فهم",
    "rate": 0.8
  },
  {
    "key": "q.t2q3",
    "text": "لِمَاذَا فَرِحَتْ أُمُّهُ؟",
    "kind": "سؤال فهم",
    "rate": 0.8
  },
  {
    "key": "q.t3q1",
    "text": "مَا الْفِكْرَةُ الرَّئِيسَةُ فِي النَّصِّ؟",
    "kind": "سؤال فهم",
    "rate": 0.8
  },
  {
    "key": "q.t3q2",
    "text": "لِمَاذَا غَرَّدَ الْعُصْفُورُ؟",
    "kind": "سؤال فهم",
    "rate": 0.8
  },
  {
    "key": "phonemic.instruction.0",
    "text": "اِسْتَمِعْ إِلَى الصَّوْتَيْنِ. هَلْ هُمَا مُتَمَاثِلَانِ؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.1",
    "text": "اِسْتَمِعْ إِلَى الصَّوْتَيْنِ. هَلْ هُمَا مُتَمَاثِلَانِ؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.2",
    "text": "أَيُّ صُورَةٍ تَبْدَأُ بِصَوْتِ /مْ/؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.3",
    "text": "أَيُّ صُورَةٍ تَبْدَأُ بِصَوْتِ /مْ/؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.4",
    "text": "أَيُّ كَلِمَةٍ تَنْتَهِي بِصَوْتِ /مْ/؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.5",
    "text": "صَفِّقْ لِمَقَاطِعِ الْكَلِمَةِ: كَمْ مَقْطَعًا تَسْمَعُ؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.6",
    "text": "صَفِّقْ لِمَقَاطِعِ الْكَلِمَةِ: كَمْ مَقْطَعًا تَسْمَعُ؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.7",
    "text": "اِسْتَمِعْ إِلَى الْمَقَاطِعِ، ثُمَّ اخْتَرِ الْكَلِمَةَ.",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.8",
    "text": "اِسْتَمِعْ إِلَى الْمَقَاطِعِ، ثُمَّ اخْتَرِ الْكَلِمَةَ.",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.9",
    "text": "كَمْ كَلِمَةً فِي الْجُمْلَةِ الَّتِي تَسْمَعُهَا؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.10",
    "text": "ثَلَاثَةُ أَصْوَاتٍ، أَيُّهَا الْمُخْتَلِفُ؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.11",
    "text": "أَيُّ كَلِمَةٍ تُشْبِهُ نِهَايَةَ كَلِمَةِ «دَار»؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.12",
    "text": "مَا الصَّوْتُ الْأَوْسَطُ فِي كَلِمَةِ «قَمَر»؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.instruction.13",
    "text": "قُلْ «مَالِك» بِدُونِ صَوْتِ /مْ/. مَاذَا يَبْقَى؟",
    "kind": "تعليمات نور",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.0",
    "text": "اِسْتَمِعْ مَرَّةً أُخْرَى وَرَكِّزْ عَلَى بِدَايَةِ الصَّوْتِ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.1",
    "text": "الصَّوْتُ الْأَوَّلُ مِنَ الشَّفَتَيْنِ، وَالثَّانِي مِنَ الْأَنْفِ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.2",
    "text": "قُلِ اسْمَ كُلِّ صُورَةٍ بِصَوْتٍ عَالٍ، وَاسْتَمِعْ إِلَى أَوَّلِ صَوْتٍ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.3",
    "text": "اِنْطِقْ: مِفْـ... مَا أَوَّلُ صَوْتٍ تَسْمَعُهُ؟",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.4",
    "text": "قُلِ الْكَلِمَةَ بِبُطْءٍ، وَرَكِّزْ عَلَى آخِرِ صَوْتٍ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.5",
    "text": "مَدْ — رَ — سَة. صَفِّقْ مَعَ كُلِّ مَقْطَعٍ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.6",
    "text": "قَ — مَرْ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.7",
    "text": "اِدْمِجِ الْمَقْطَعَيْنِ بِسُرْعَةٍ: سَ + مَك.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.8",
    "text": "كِ + تَاب.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.9",
    "text": "عُدَّ عَلَى أَصَابِعِكَ مَعَ كُلِّ كَلِمَةٍ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.10",
    "text": "الصَّوْتَانِ الْأَوَّلَانِ مِنَ الشَّفَتَيْنِ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.11",
    "text": "اِسْتَمِعْ إِلَى آخِرِ الْكَلِمَةِ: ...ـار.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.12",
    "text": "قُلْهَا بِبُطْءٍ: قْ — مْ — رْ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "phonemic.hint.13",
    "text": "اِحْذِفْ أَوَّلَ صَوْتٍ فَقَطْ، وَاتْرُكِ الْبَاقِيَ كَمَا هُوَ.",
    "kind": "تلميح",
    "rate": 0.82
  },
  {
    "key": "world.intro.0",
    "text": "هُنَا نَسْتَمِعُ فَقَطْ، بِلَا حُرُوفٍ مَكْتُوبَةٍ.",
    "kind": "تقديم عالم",
    "rate": 0.82
  },
  {
    "key": "world.intro.1",
    "text": "سَنَتَعَرَّفُ إِلَى صَوْتِ الحَرْفِ قَبْلَ اسْمِهِ.",
    "kind": "تقديم عالم",
    "rate": 0.82
  },
  {
    "key": "world.intro.2",
    "text": "الحَرَكَةُ تُغَيِّرُ صَوْتَ الحَرْفِ.",
    "kind": "تقديم عالم",
    "rate": 0.82
  },
  {
    "key": "world.intro.3",
    "text": "سَنَبْنِي المَقْطَعَ بِأَنْفُسِنَا.",
    "kind": "تقديم عالم",
    "rate": 0.82
  },
  {
    "key": "world.intro.4",
    "text": "حُرُوفُ المَدِّ تُطِيلُ الصَّوْتَ.",
    "kind": "تقديم عالم",
    "rate": 0.82
  },
  {
    "key": "world.intro.5",
    "text": "سَنَضُمُّ المَقَاطِعَ حَتَّى تَظْهَرَ الكَلِمَةُ.",
    "kind": "تقديم عالم",
    "rate": 0.82
  },
